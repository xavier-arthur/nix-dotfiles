// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "auto_update": false,
    "icon_theme": "Warm Charmed Icons",
    "project_panel": {
        "dock": "right"
    },

    "ui_font_size": 15,
    "buffer_font_size": 12,

    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark Pro"
        // "dark": "Gruvbox Material"
    },

    "vim_mode": true,

    "vim": {
        "use_smartcase_find": true,
        "use_system_clipboard": "never"
    },

    "relative_line_numbers": "enabled",
    "disable_ai": true,

    "format_on_save": "off",

    "ui_font_family": "IBM Plex Mono",
    "buffer_font_family": "Departure Mono",

    // "buffer_font_family": "PixelCodeLigatureless Nerd Font",

    "tab_size": 4,

    "lsp": {
        "rust-analyzer": {
            "binary": {
                "path": "/run/current-system/sw/bin/rust-analyzer"
            }
        },

        // "vue-language-server": {
        //     "binary": {
        //         "path": "/run/current-system/sw/bin/node",
        //         "arguments": [
        //             "/home/arthurx/.lsp/node_modules/.bin/vue-language-server",
        //             "--stdio"
        //         ]
        //     }
        // },

        "phpactor": {
            "binary": {
                "path": "/run/current-system/sw/bin/true"
            }
        },

        // "deno": {
        //     "settings": {
        //         "deno": {
        //             "enable": true
        //         }
        //     }
        // },
    },

    "auto_install_extensions": {
        "vue": false
    },

    "auto_update_extensions": {
        "vue": false
    },

    "languages": {
        "Nix": {
            "enable_language_server": true
        },

        "YAML": {
            "tab_size": 2
        },

        "PHP": {
            "enable_language_server": true,
            "language_servers": ["intelephense", "!phpactor", "!phptools", "..."]
        },

        "Vue.js": {
            "language_servers": [
                "vtsls",
                "..."
            ]
        },

        "Shell Script": {
            "tab_size": 2
        },

        "TypeScript": {
            "language_servers": [
                "deno",
                "!typescript-language-server",
                "!vtsls",
                "!eslint"
            ]
        }

    },

    "experimental.theme_overrides": {
        "hint": "#665c54",
        "hint.background": "#252523",
        // "hint.border": null,

        "syntax": {

            "keyword": {
                "color": "#E67E80",
                "font_style": "italic"
            },

            "tag": {
                "color": "#E69875",
            },

            "constructor": {
                "color": "#e5c07b"
            },

            "variable":  { "color": "#D3C6AA" },
            "attribute":  { "color": "#D3C6AA" },
            "property": { "color": "#83C092" },
        },

        // "syntax": {
        //     "keyword": {
        //         "color": "#ea6962",
        //         "font_style": "italic"
        //     },

        //     "property": {
        //         "color": "#d4be98"
        //     },

        //     "tag": {
        //         "color": "#ea6962",
        //     },

        //     "function": {
        //         "color": "#a9b665"
        //     },

        //     "type": {
        //         "color": "#7daea3"
        //     },

        //     "operator": {
        //         "color": "#e78a4e"
        //     },

        //     "number": {
        //         "color": "#d3869b"
        //     },

        //     "variable": {
        //         "color": "#d4be98"
        //     },

        //     "constructor": {
        //         "color": "#7daea3"
        //     },

        //     "string": {
        //         "color": "#d8a657"
        //     },

        //     "boolean": {
        //         "color": "#d3869b"
        //     }
        // },
    },

    "inlay_hints": {
        "enabled": false,
        "show_background": true,
        "show_parameter_hints": false,
        "show_other_hints": false,
        "toggle_on_modifiers_press": {
            "alt": true
        }
    },

    "ensure_final_newline_on_save": false,
    "hide_mouse": "never"
}
